{{ define "components/navBar" }}
<header class="site-header">
  <a class="wordmark" href="/" aria-label="Piper home">
    <span class="wordmark-symbol" aria-hidden="true"><i></i><i></i><i></i></span>
    <span>piper</span>
  </a>
  <nav aria-label="Main navigation">
    {{ if .IsLoggedIn }}
    <a href="/"{{ if eq .CurrentPage "connections" }} aria-current="page"{{ end }}>Connections</a>
    <a href="/api-keys"{{ if eq .CurrentPage "api-access" }} aria-current="page"{{ end }}>API access</a>
    {{ else }}
    <a href="https://teal.fm">About teal.fm</a>
    {{ end }}
  </nav>
</header>
{{ end }}
