{{ define "content" }}
{{ template "components/navBar" .NavBar }}

{{ if .NavBar.IsLoggedIn }}
<section class="page-intro" aria-labelledby="page-title">
  <div>
    <h1 id="page-title">your music, piped into one place.</h1>
  </div>
  <p class="intro-copy">See which sources you use and the latest listen Piper received from each one.</p>
</section>

<main class="connection-map">
  <div class="service-grid" aria-label="Music service connections">
    <article class="service-panel {{ if not .NavBar.SpotifyEnabled }}is-unavailable{{ else if and .User .User.SpotifyID }}is-connected{{ else }}is-not-connected{{ end }}">
      <header class="service-header">
        <div class="service-identity">
          <span class="service-mark spotify-mark" aria-hidden="true">S</span>
          <div>
            <h2>Spotify</h2>
            {{ if not .NavBar.SpotifyEnabled }}<p class="status-label"><span class="status-dot"></span>Unavailable on this Piper</p>
            {{ else if and .User .User.SpotifyID }}<p class="status-label"><span class="status-dot"></span>Connected</p>
            {{ else }}<p class="status-label"><span class="status-dot"></span>Not connected</p>{{ end }}
          </div>
        </div>
      </header>
      <div class="service-body">
        {{ if not .NavBar.SpotifyEnabled }}
        <p class="service-note">The server owner has turned off Spotify tracking.</p>
        {{ else if and .User .User.SpotifyID }}
        <p class="account-line">Signed in as <strong>{{ .User.SpotifyID }}</strong></p>
        {{ if .SpotifyTrack }}
        <div class="latest-listen">
          <p class="detail-label">Last tracked play</p>
          <p class="track-name">{{ .SpotifyTrack.Name }}</p>
          <p class="track-artist">{{ artistNames .SpotifyTrack.Artist }}</p>
          <time datetime="{{ .SpotifyTrack.Timestamp.Format "2006-01-02T15:04:05Z07:00" }}">{{ formatTime .SpotifyTrack.Timestamp }}</time>
        </div>
        {{ else }}
        <div class="empty-listen"><p class="detail-label">Last tracked play</p><p>Nothing yet. Play something on Spotify and Piper will pick it up.</p></div>
        {{ end }}
        {{ else }}
        <p class="service-note">Connect Spotify to start recording what you play.</p>
        {{ end }}
      </div>
      <footer class="service-actions">
        {{ if .NavBar.SpotifyEnabled }}
          {{ if and .User .User.SpotifyID }}
          <a class="text-action" href="/history">View history <span aria-hidden="true">↗</span></a>
          <a class="quiet-action" href="/login/spotify">Reconnect</a>
          {{ else }}<a class="primary-action" href="/login/spotify">Connect Spotify</a>{{ end }}
        {{ end }}
      </footer>
    </article>

    <article class="service-panel {{ if not .NavBar.AppleMusicEnabled }}is-unavailable{{ else if and .User .User.AppleMusicUserToken }}is-connected{{ else }}is-not-connected{{ end }}">
      <header class="service-header">
        <div class="service-identity">
          <span class="service-mark apple-mark" aria-hidden="true">♪</span>
          <div>
            <h2>Apple Music</h2>
            {{ if not .NavBar.AppleMusicEnabled }}<p class="status-label"><span class="status-dot"></span>Unavailable on this Piper</p>
            {{ else if and .User .User.AppleMusicUserToken }}<p class="status-label"><span class="status-dot"></span>Connected</p>
            {{ else }}<p class="status-label"><span class="status-dot"></span>Not connected</p>{{ end }}
          </div>
        </div>
      </header>
      <div class="service-body">
        {{ if not .NavBar.AppleMusicEnabled }}
        <p class="service-note">The server owner has turned off Apple Music tracking.</p>
        {{ else if and .User .User.AppleMusicUserToken }}
        <p class="account-line">MusicKit authorization is active.</p>
        {{ if .AppleMusicTrack }}
        <div class="latest-listen">
          <p class="detail-label">Last tracked play</p>
          <p class="track-name">{{ .AppleMusicTrack.Name }}</p>
          <p class="track-artist">{{ artistNames .AppleMusicTrack.Artist }}</p>
          <time datetime="{{ .AppleMusicTrack.Timestamp.Format "2006-01-02T15:04:05Z07:00" }}">{{ formatTime .AppleMusicTrack.Timestamp }}</time>
        </div>
        {{ else }}
        <div class="empty-listen"><p class="detail-label">Last tracked play</p><p>Nothing yet. Your next recent play will appear here.</p></div>
        {{ end }}
        {{ else }}
        <p class="service-note">Authorize Apple Music to import your recent plays.</p>
        {{ end }}
      </div>
      <footer class="service-actions">
        {{ if .NavBar.AppleMusicEnabled }}
          {{ if and .User .User.AppleMusicUserToken }}
          <button class="quiet-action" type="button" data-apple-unlink>Unlink Apple Music</button>
          {{ else }}
          <button class="primary-action" type="button" data-apple-authorize>Connect Apple Music</button>
          {{ end }}
        {{ end }}
      </footer>
      <p class="service-inline-status" data-apple-status role="status" aria-live="polite"></p>
    </article>

    <article class="service-panel {{ if not .NavBar.LastFMEnabled }}is-unavailable{{ else if .NavBar.LastFMUsername }}is-connected{{ else }}is-not-connected{{ end }}">
      <header class="service-header">
        <div class="service-identity">
          <span class="service-mark lastfm-mark" aria-hidden="true">fm</span>
          <div>
            <h2>Last.fm</h2>
            {{ if not .NavBar.LastFMEnabled }}<p class="status-label"><span class="status-dot"></span>Unavailable on this Piper</p>
            {{ else if .NavBar.LastFMUsername }}<p class="status-label"><span class="status-dot"></span>Connected</p>
            {{ else }}<p class="status-label"><span class="status-dot"></span>Not connected</p>{{ end }}
          </div>
        </div>
      </header>
      <div class="service-body">
        {{ if not .NavBar.LastFMEnabled }}
        <p class="service-note">The server owner has turned off Last.fm syncing.</p>
        {{ else if .NavBar.LastFMUsername }}
        <p class="account-line">Syncing <strong>{{ .NavBar.LastFMUsername }}</strong></p>
        {{ if .LastFMTrack }}
        <div class="latest-listen">
          <p class="detail-label">Last tracked play</p>
          <p class="track-name">{{ .LastFMTrack.Name }}</p>
          <p class="track-artist">{{ artistNames .LastFMTrack.Artist }}</p>
          <time datetime="{{ .LastFMTrack.Timestamp.Format "2006-01-02T15:04:05Z07:00" }}">{{ formatTime .LastFMTrack.Timestamp }}</time>
        </div>
        {{ else }}
        <div class="empty-listen"><p class="detail-label">Last tracked play</p><p>No scrobbles have reached Piper yet.</p></div>
        {{ end }}
        {{ else }}
        <p class="service-note">Add your Last.fm username to begin syncing scrobbles.</p>
        {{ end }}
      </div>
      <footer class="service-actions">
        {{ if or .NavBar.LastFMEnabled .NavBar.LastFMUsername }}
        <a class="{{ if .NavBar.LastFMUsername }}quiet-action{{ else }}primary-action{{ end }}" href="/link-lastfm">{{ if .NavBar.LastFMUsername }}Change username{{ else }}Set username{{ end }}</a>
        {{ end }}
      </footer>
    </article>
  </div>

  <div class="connection-lines" aria-hidden="true"><span></span><span></span><span></span></div>

  <section class="atmosphere-account" aria-labelledby="atmosphere-title" data-atmosphere-account data-profile-ready="{{ if .Atmosphere.PDS }}true{{ else }}false{{ end }}">
    {{ if .Atmosphere.AvatarURL }}
    <img class="atmosphere-avatar" src="{{ .Atmosphere.AvatarURL }}" alt="" data-atmosphere-visual />
    {{ else }}
    <div class="atmosphere-symbol" aria-hidden="true" data-atmosphere-visual><span></span><span></span><span></span></div>
    {{ end }}
    <div>
      <p class="detail-label">Atmosphere account</p>
      <h2 id="atmosphere-title" data-atmosphere-handle>{{ if .Atmosphere.Handle }}@{{ .Atmosphere.Handle }}{{ else }}Loading account…{{ end }}</h2>
      <p data-atmosphere-pds>PDS: {{ if .Atmosphere.PDS }}{{ .Atmosphere.PDS }}{{ else }}Loading…{{ end }}</p>
      <div class="atmosphere-links">
        <a class="atmosphere-record" href="#" target="_blank" rel="noreferrer" data-view-record hidden>View Record</a>
        <a class="atmosphere-logout" href="/logout">Logout</a>
      </div>
    </div>
  </section>
</main>

<script>
  (() => {
    const account = document.querySelector("[data-atmosphere-account]");
    if (!account || account.dataset.profileReady === "true") return;

    const wait = (milliseconds) => new Promise((resolve) => window.setTimeout(resolve, milliseconds));
    async function loadProfile() {
      for (let attempt = 0; attempt < 10; attempt += 1) {
        try {
          const response = await fetch("/api/v1/atmosphere-profile", { credentials: "same-origin" });
          if (response.ok) {
            const profile = await response.json();
            account.querySelector("[data-atmosphere-handle]").textContent = profile.handle ? `@${profile.handle}` : "Handle unavailable";
            account.querySelector("[data-atmosphere-pds]").textContent = profile.pds ? `PDS: ${profile.pds}` : "PDS: Unavailable";
            if (profile.avatar_url) {
              const image = document.createElement("img");
              image.className = "atmosphere-avatar";
              image.src = profile.avatar_url;
              image.alt = "";
              image.dataset.atmosphereVisual = "";
              account.querySelector("[data-atmosphere-visual]").replaceWith(image);
            }
            account.dataset.profileReady = "true";
            return;
          }
          if (response.status !== 202) return;
        } catch (error) {
          console.warn("Atmosphere profile is not available yet", error);
        }
        await wait(500);
      }
      account.querySelector("[data-atmosphere-handle]").textContent = "Handle unavailable";
      account.querySelector("[data-atmosphere-pds]").textContent = "PDS: Unavailable";
    }
    async function loadLatestRecord() {
      for (let attempt = 0; attempt < 10; attempt += 1) {
        try {
          const response = await fetch("/api/v1/latest-record", { credentials: "same-origin" });
          if (response.ok && response.status !== 204) {
            const record = await response.json();
            const link = account.querySelector("[data-view-record]");
            link.href = record.url;
            link.hidden = false;
            return;
          }
          if (response.status !== 202) return;
        } catch (error) {
          console.warn("Latest listening record is not available yet", error);
        }
        await wait(500);
      }
    }
    loadProfile();
    loadLatestRecord();
  })();
</script>

{{ if .NavBar.AppleMusicEnabled }}
<script>
  (() => {
    const authorizeButton = document.querySelector("[data-apple-authorize]");
    const unlinkButton = document.querySelector("[data-apple-unlink]");
    const status = document.querySelector("[data-apple-status]");
    const developerToken = "{{ .AppleMusicDevToken }}";
    const musicKitSource = "https://js-cdn.music.apple.com/musickit/v3/musickit.js";
    let musicKitLoadPromise;

    function setStatus(message) {
      status.textContent = message;
    }

    function loadMusicKit() {
      if (window.MusicKit) return Promise.resolve();
      if (musicKitLoadPromise) return musicKitLoadPromise;

      musicKitLoadPromise = new Promise((resolve, reject) => {
        const script = document.createElement("script");
        let settled = false;
        const timeout = window.setTimeout(() => {
          finish(new Error("Apple Music did not load. Check your connection and try again."));
        }, 10000);

        function finish(error) {
          if (settled) return;
          settled = true;
          window.clearTimeout(timeout);
          document.removeEventListener("musickitloaded", onLoaded);
          script.removeEventListener("error", onError);
          if (error) {
            script.remove();
            reject(error);
            return;
          }
          resolve();
        }

        function onLoaded() {
          if (!window.MusicKit) {
            finish(new Error("Apple Music loaded without MusicKit. Try again."));
            return;
          }
          finish();
        }

        function onError() {
          finish(new Error("Apple Music could not load. Check your connection and try again."));
        }

        document.addEventListener("musickitloaded", onLoaded, { once: true });
        script.addEventListener("error", onError, { once: true });
        script.src = musicKitSource;
        script.async = true;
        script.dataset.webComponents = "";
        document.head.appendChild(script);
      }).finally(() => {
        musicKitLoadPromise = undefined;
      });

      return musicKitLoadPromise;
    }

    async function getMusicKit() {
      await loadMusicKit();
      try {
        window.MusicKit.configure({ developerToken, app: { name: "Piper", build: "1.0.0" } });
      } catch (error) {
        if (!String(error).includes("already")) throw error;
      }
      return window.MusicKit.getInstance();
    }

    authorizeButton?.addEventListener("click", async () => {
      authorizeButton.disabled = true;
      setStatus("Waiting for Apple Music authorization…");
      try {
        const music = await getMusicKit();
        const userToken = await music.authorize();
        const response = await fetch("/api/v1/applemusic/authorize", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          credentials: "same-origin",
          body: JSON.stringify({ userToken })
        });
        if (!response.ok) throw new Error("Piper could not save the Apple Music authorization.");
        window.location.reload();
      } catch (error) {
        console.error("Apple Music authorization failed", error);
        setStatus(error.message || "Apple Music authorization failed.");
        authorizeButton.disabled = false;
      }
    });

    unlinkButton?.addEventListener("click", async () => {
      if (!confirm("Unlink Apple Music from Piper? Recent play imports will stop.")) return;
      unlinkButton.disabled = true;
      setStatus("Removing Apple Music access…");
      try {
        try {
          const music = await getMusicKit();
          await music.unauthorize();
        } catch (error) {
          console.warn("Apple Music session could not be cleared locally", error);
        }
        const response = await fetch("/api/v1/applemusic/unlink", { method: "POST", credentials: "same-origin" });
        if (!response.ok) throw new Error("Piper could not remove the Apple Music connection.");
        window.location.reload();
      } catch (error) {
        console.error("Apple Music unlink failed", error);
        setStatus(error.message || "Apple Music could not be unlinked.");
        unlinkButton.disabled = false;
      }
    });
  })();
</script>
{{ end }}

{{ else }}
<main class="login-shell">
  <section class="login-copy" aria-labelledby="login-title">
    <h1 id="login-title">your music, in your atmosphere.</h1>
    <p>Connect the services you listen with. Piper sends each play to the Atmosphere account you own.</p>
  </section>
  <section class="login-panel" aria-label="Sign in to Piper">
    <div class="login-panel-heading">
      <span class="atmosphere-symbol" aria-hidden="true"><span></span><span></span><span></span></span>
      <h2>Sign in with ATProto</h2>
    </div>
    <form class="stacked-form" action="/login/atproto" data-handle-form>
      <label for="handle">Your handle</label>
      <div class="typeahead-control">
        <div class="input-group">
          <input
            type="text"
            id="handle"
            name="handle"
            autocomplete="off"
            autocapitalize="none"
            spellcheck="false"
            placeholder="you.bsky.social"
            role="combobox"
            aria-autocomplete="list"
            aria-controls="actor-results"
            aria-expanded="false"
            required
          />
          <button type="submit">Continue <span aria-hidden="true">→</span></button>
        </div>
        <div id="actor-results" class="typeahead-results" role="listbox" aria-label="Matching Atmosphere accounts" hidden></div>
      </div>
      <p id="typeahead-status" class="sr-only" role="status" aria-live="polite"></p>
      <p class="field-help">Piper uses your handle to start ATProto sign-in. It never asks for your password.</p>
    </form>
  </section>
</main>

<script>
  (() => {
    const form = document.querySelector("[data-handle-form]");
    if (!form) return;

    const input = form.querySelector("#handle");
    const resultsElement = form.querySelector("#actor-results");
    const statusElement = form.querySelector("#typeahead-status");
    const endpoint = "https://typeahead.waow.tech/xrpc/tech.waow.typeahead.searchActors";
    const resultCache = new Map();
    let actors = [];
    let activeIndex = -1;
    let debounceTimer;
    let requestController;

    function normalizedQuery() {
      return input.value.trim().replace(/^@/, "");
    }

    function closeResults() {
      actors = [];
      activeIndex = -1;
      resultsElement.replaceChildren();
      resultsElement.hidden = true;
      input.setAttribute("aria-expanded", "false");
      input.removeAttribute("aria-activedescendant");
    }

    function selectActor(actor) {
      input.value = actor.handle;
      closeResults();
      input.focus();
    }

    function setActiveIndex(nextIndex) {
      if (!actors.length) return;
      activeIndex = (nextIndex + actors.length) % actors.length;
      const options = resultsElement.querySelectorAll("[role='option']");
      options.forEach((option, index) => {
        const selected = index === activeIndex;
        option.setAttribute("aria-selected", String(selected));
        if (selected) {
          input.setAttribute("aria-activedescendant", option.id);
          option.scrollIntoView({ block: "nearest" });
        }
      });
    }

    function renderActors(nextActors) {
      actors = nextActors.slice(0, 6);
      activeIndex = -1;
      resultsElement.replaceChildren();

      if (!actors.length) {
        closeResults();
        statusElement.textContent = "No matching accounts found.";
        return;
      }

      actors.forEach((actor, index) => {
        const option = document.createElement("button");
        option.type = "button";
        option.id = `actor-option-${index}`;
        option.className = "typeahead-option";
        option.setAttribute("role", "option");
        option.setAttribute("aria-selected", "false");

        const avatar = document.createElement("span");
        avatar.className = "actor-avatar";
        avatar.setAttribute("aria-hidden", "true");
        if (actor.avatar) {
          const image = document.createElement("img");
          image.src = actor.avatar;
          image.alt = "";
          image.loading = "lazy";
          image.referrerPolicy = "no-referrer";
          image.addEventListener("error", () => {
            image.remove();
            avatar.textContent = (actor.displayName || actor.handle || "?").slice(0, 1).toUpperCase();
          }, { once: true });
          avatar.append(image);
        } else {
          avatar.textContent = (actor.displayName || actor.handle || "?").slice(0, 1).toUpperCase();
        }

        const identity = document.createElement("span");
        identity.className = "actor-identity";
        const name = document.createElement("strong");
        name.textContent = actor.displayName || actor.handle;
        const handle = document.createElement("span");
        handle.textContent = `@${actor.handle}`;
        identity.append(name, handle);

        option.append(avatar, identity);
        option.addEventListener("pointerdown", (event) => event.preventDefault());
        option.addEventListener("click", () => selectActor(actor));
        option.addEventListener("mouseenter", () => setActiveIndex(index));
        resultsElement.append(option);
      });

      resultsElement.hidden = false;
      input.setAttribute("aria-expanded", "true");
      statusElement.textContent = `${actors.length} matching accounts found.`;
    }

    async function searchActors(query) {
      if (resultCache.has(query)) {
        renderActors(resultCache.get(query));
        return;
      }

      requestController?.abort();
      const controller = new AbortController();
      requestController = controller;
      form.querySelector(".typeahead-control").classList.add("is-loading");
      input.setAttribute("aria-busy", "true");
      statusElement.textContent = "Searching Atmosphere accounts.";

      try {
        const url = new URL(endpoint);
        url.searchParams.set("q", query);
        url.searchParams.set("limit", "6");
        const response = await fetch(url, {
          headers: { "X-Client": "github.com/teal-fm/piper" },
          signal: controller.signal
        });
        if (!response.ok) throw new Error(`Typeahead returned ${response.status}`);
        const data = await response.json();
        const nextActors = Array.isArray(data.actors) ? data.actors : [];
        resultCache.set(query, nextActors);
        if (normalizedQuery() === query) renderActors(nextActors);
      } catch (error) {
        if (error.name === "AbortError") return;
        closeResults();
        statusElement.textContent = "Account suggestions are unavailable. You can still continue with the handle you entered.";
      } finally {
        if (requestController === controller) {
          form.querySelector(".typeahead-control").classList.remove("is-loading");
          input.removeAttribute("aria-busy");
        }
      }
    }

    input.addEventListener("input", () => {
      window.clearTimeout(debounceTimer);
      requestController?.abort();
      closeResults();
      const query = normalizedQuery();
      if (query.length < 2) return;
      debounceTimer = window.setTimeout(() => searchActors(query), 240);
    });

    input.addEventListener("keydown", (event) => {
      if (event.key === "ArrowDown" && actors.length) {
        event.preventDefault();
        setActiveIndex(activeIndex + 1);
      } else if (event.key === "ArrowUp" && actors.length) {
        event.preventDefault();
        setActiveIndex(activeIndex - 1);
      } else if (event.key === "Enter" && activeIndex >= 0) {
        event.preventDefault();
        selectActor(actors[activeIndex]);
        form.requestSubmit();
      } else if (event.key === "Escape") {
        closeResults();
      }
    });

    input.addEventListener("focus", () => {
      const cached = resultCache.get(normalizedQuery());
      if (cached) renderActors(cached);
    });

    document.addEventListener("pointerdown", (event) => {
      if (!form.contains(event.target)) closeResults();
    });
  })();
</script>
{{ end }}
{{ end }}
