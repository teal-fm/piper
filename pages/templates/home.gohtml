{{ define "title" }}piper{{ end }}

{{ define "content" }}

{{ template "components/navBar" .NavBar }}

{{ if .NavBar.IsLoggedIn }}

<h1 class="text-2xl font-medium tracking-tight mb-1">Your services</h1>
<p class="text-neutral-500 dark:text-neutral-400 mb-6">
  Connect a service and piper records what you listen to.
</p>

<div class="grid gap-4 sm:grid-cols-3">
  {{ range .NavBar.Services }}
  {{ template "components/serviceCard" . }}
  {{ end }}
</div>

{{ else }}

<div class="max-w-sm">
  <h1 class="text-3xl font-medium tracking-tight mb-2">piper</h1>
  <p class="text-neutral-500 dark:text-neutral-400 mb-8">
    <strong>Piper</strong> is a multi-user application that records what you're listening to on Spotify,
      Apple Music, and Last.fm, saving your listening history.
  </p>

  <form class="space-y-3" action="/login/atproto">
    <label
      class="block text-sm font-medium text-neutral-600 dark:text-neutral-300"
      for="handle">ATProto handle</label>
    <input
      class="block w-full px-3 py-2 rounded-lg border border-neutral-400/30 bg-white/60 dark:bg-neutral-900/60 backdrop-blur-sm placeholder:text-neutral-400 dark:placeholder:text-neutral-600 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent"
      type="text"
      id="handle"
      name="handle"
      placeholder="alice.bsky.social"
      autocapitalize="none"
      autocorrect="off"
      spellcheck="false"
      required
    />
    <button
      class="px-4 py-2 rounded-lg bg-accent text-neutral-950 font-medium cursor-pointer hover:opacity-90"
      type="submit">
      Log in
    </button>
  </form>
</div>

{{ end }}

<footer class="mt-12 text-sm text-neutral-400 dark:text-neutral-600">
  Built {{ if .BuildTime.IsZero }}unknown{{ else }}{{ formatTime .BuildTime }} UTC{{ end }}{{ if .Agent }} &middot; {{ .Agent }}{{ end }}
</footer>

{{ end }}
