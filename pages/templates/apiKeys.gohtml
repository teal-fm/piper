{{ define "title" }}API keys · piper{{ end }}

{{ define "content" }}

{{ template "components/navBar" .NavBar }}

<h1 class="text-2xl font-medium tracking-tight mb-1">API keys</h1>
<p class="text-neutral-500 dark:text-neutral-400 mb-6">
  API keys allow programmatic access to your piper account data.
</p>

<div class="rounded-xl border border-neutral-400/20 bg-white/50 dark:bg-neutral-900/50 backdrop-blur-sm p-5 mb-5">
  <h2 class="font-medium mb-3">Create a new key</h2>
  <form class="space-y-3" method="POST" action="/api-keys">
    <label
      class="block text-sm font-medium text-neutral-600 dark:text-neutral-300"
      for="name">Key name (for your reference)</label>
    <input
      class="block w-full px-3 py-2 rounded-lg border border-neutral-400/30 bg-white/60 dark:bg-neutral-900/60 backdrop-blur-sm placeholder:text-neutral-400 dark:placeholder:text-neutral-600 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent"
      type="text"
      id="name"
      name="name"
      placeholder="My Application"
    />
    <button
      class="px-4 py-2 rounded-lg bg-accent text-neutral-950 font-medium cursor-pointer hover:opacity-90"
      type="submit">
      Generate new API key
    </button>
  </form>
</div>

{{ if .NewKeyID }}
<div class="rounded-xl border border-accent/40 bg-accent/10 backdrop-blur-sm p-5 mb-5">
  <h2 class="font-medium text-accent mb-2">Your new API key</h2>
  <pre
    class="font-mono text-sm p-3 rounded-lg whitespace-pre-wrap break-all bg-white/60 dark:bg-neutral-900/60 border border-neutral-400/20">{{ .NewKeyID }}</pre>
  <p class="text-sm text-neutral-600 dark:text-neutral-300 mt-3">
    <strong>Important:</strong> treat this like a password.
  </p>
</div>
{{ end }}

<div class="rounded-xl border border-neutral-400/20 bg-white/50 dark:bg-neutral-900/50 backdrop-blur-sm p-5 mb-5">
  <h2 class="font-medium mb-3">Your keys</h2>
  {{ if .Keys }}
  <div class="overflow-x-auto">
    <table class="w-full border-collapse text-sm">
      <thead>
        <tr
          class="text-left border-b border-neutral-400/20 text-neutral-600 dark:text-neutral-400">
          <th class="py-2 pr-2 font-medium">Name</th>
          <th class="py-2 pr-2 font-medium">Created</th>
          <th class="py-2 pr-2 font-medium">Expires</th>
          <th class="py-2 font-medium">Actions</th>
        </tr>
      </thead>
      <tbody>
        {{ range .Keys }}
        <tr class="border-b border-neutral-400/10">
          <td class="py-2 pr-2">{{ .Name }}</td>
          <td class="py-2 pr-2">{{ formatTime .CreatedAt }}</td>
          <td class="py-2 pr-2">{{ formatTime .ExpiresAt }}</td>
          <td class="py-2">
            <button
              class="text-red-600 dark:text-red-400 underline cursor-pointer p-0 bg-transparent"
              onclick="deleteKey('{{ .ID }}')">
              Delete
            </button>
          </td>
        </tr>
        {{ end }}
      </tbody>
    </table>
  </div>
  {{ else }}
  <p class="text-sm text-neutral-500 dark:text-neutral-400">
    You don't have any API keys yet.
  </p>
  {{ end }}
</div>

<div class="rounded-xl border border-neutral-400/20 bg-white/50 dark:bg-neutral-900/50 backdrop-blur-sm p-5 mb-5">
  <h2 class="font-medium mb-3">Usage</h2>
  <p class="text-sm mb-2">
    To use your API key, include it in the Authorization header of your HTTP
    requests:
  </p>
  <pre
    class="font-mono text-sm p-3 rounded-lg overflow-x-auto bg-white/60 dark:bg-neutral-900/60 border border-neutral-400/20">Authorization: Bearer YOUR_API_KEY</pre>
  <p class="text-sm mt-4 mb-2">
    Or include it as a query parameter (less secure for the key itself):
  </p>
  <pre
    class="font-mono text-sm p-3 rounded-lg overflow-x-auto bg-white/60 dark:bg-neutral-900/60 border border-neutral-400/20">https://your-piper-instance.com/endpoint?api_key=YOUR_API_KEY</pre>
</div>

<script>
    function deleteKey(keyId) {
        if (confirm('Are you sure you want to delete this API key? This action cannot be undone.')) {
            fetch('/api-keys?key_id=' + keyId, { // This endpoint is handled by HandleAPIKeyManagement
                method: 'DELETE',
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        window.location.reload();
                    } else {
                        alert('Failed to delete API key: ' + (data.error || 'Unknown error'));
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Failed to delete API key due to a network or processing error.');
                });
        }
    }
</script>

{{ end }}
